{
  "name": "autoreel-zen",
  "version": "1.5.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "AUTOREEL ZEN — hands-free Instagram reels studio on a 1,000-agent swarm, reels first",
  "author": "Manashjyoti Bora",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Manashjyoti-Bora/autoreel-zen.git"
  },
  "bugs": {
    "url": "https://github.com/Manashjyoti-Bora/autoreel-zen/issues"
  },
  "homepage": "https://github.com/Manashjyoti-Bora/autoreel-zen#readme",
  "keywords": [
    "instagram",
    "reels",
    "content-automation",
    "ai-agents",
    "swarm",
    "cloudflare-workers",
    "hono",
    "open-source"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build && node scripts/build-worker.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "check": "npm run typecheck && npm run build",
    "dev": "npm run build && wrangler dev --ip 0.0.0.0 --port 3000",
    "start": "wrangler dev --ip 0.0.0.0 --port 3000",
    "serve": "node scripts/serve-local.mjs",
    "cf:setup": "node scripts/cloudflare.mjs setup",
    "deploy": "node scripts/cloudflare.mjs deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261127.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "optionalDependencies": {
    "wrangler": "^4.20.0"
  }
}
